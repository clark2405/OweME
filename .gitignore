# Root-level ignores for the OweMe monorepo.
# Each sub-app (app/, web/) also ships its own .gitignore.

# Secrets — never commit. Public values use the EXPO_PUBLIC_ prefix and live in
# .env files too, but we keep all .env out of git and document keys in .env.example.
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Supabase local
supabase/.branches/
supabase/.temp/
