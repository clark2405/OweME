# Mobile app environment — copy to .env and fill in.
# Only EXPO_PUBLIC_-prefixed vars are exposed to the client bundle.
# These two are genuinely public (Supabase URL + anon key, protected by RLS).

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
