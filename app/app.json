{
  "expo": {
    "name": "OweMe",
    "slug": "oweme",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "oweme",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/OweMe.icon",
      "bundleIdentifier": "com.clark24smoothoperator.oweme",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "viber"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.clark24smoothoperator.oweme"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFBF5",
          "image": "./assets/images/OweMeLogoSmall.png",
          "imageWidth": 184,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#17120D",
            "image": "./assets/images/OweMeLogoSmall.png",
            "imageWidth": 184,
            "resizeMode": "contain"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OweMe uses your photos so you can attach a picture of the thing you lent.",
          "cameraPermission": "OweMe uses your camera so you can snap a quick photo of the thing you're lending.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "OweMe can pull a name and number from your contacts so nudges go straight to the right person."
        }
      ],
      "expo-image",
      "expo-quick-actions",
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "OweMe uses Face ID to lock your private ledger so only you can open it."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
